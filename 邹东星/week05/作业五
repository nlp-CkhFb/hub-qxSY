import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, Dataset

HERE = os.path.dirname(os.path.abspath(__file__))

# ═══════════════════ 特殊符号 ═══════════════════
# 预训练语料里没有这几个符号，所以要扩词表（见 build_model_from_ckpt）
PAD, EOS, UNK = "<pad>", "<eos>", "<unk>"
SPECIALS = [PAD, EOS, UNK]

IGNORE = -100   # cross_entropy 的 ignore_index：label 等于它的位置不参与 loss

# 对话模板。真实工程里这行就是 tokenizer.apply_chat_template(...)，作用完全一样：
# 用一个固定格式告诉模型「哪段是问、哪段是答」，模型靠它区分边界
TEMPLATE = "问：{}\n答："


# ═══════════════════ 模型：和 transformer_lm.py 完全一致 ═══════════════════

class TransformerLM(nn.Module):
    """
    可学习位置编码 + N 层 TransformerEncoderLayer（带因果掩码）+ 共享权重的输出头。

    这个类和 transformer_lm.py 里的逐字相同 —— SFT 不需要动架构。
    唯一新增的是 forward 允许传 labels，内部用 -100 屏蔽 prompt 部分。
    """

    def __init__(self, vocab_size, d_model=192, n_head=4, n_layer=4, max_len=512,
                 dropout=0.1, use_pos=True, causal=True):
        super().__init__()
        self.causal = causal
        self.use_pos = use_pos
        self.tok = nn.Embedding(vocab_size, d_model)
        self.pos = nn.Embedding(max_len, d_model) if use_pos else None
        self.drop = nn.Dropout(dropout)

        layer = nn.TransformerEncoderLayer(
            d_model=d_model, nhead=n_head, dim_feedforward=4 * d_model,
            dropout=dropout, activation="gelu", batch_first=True, norm_first=True,
        )
        self.encoder = nn.TransformerEncoder(
            layer, num_layers=n_layer, norm=nn.LayerNorm(d_model),
            enable_nested_tensor=False,
        )
        self.head = nn.Linear(d_model, vocab_size, bias=False)
        self.head.weight = self.tok.weight          # weight tying，必须保留

        nn.init.normal_(self.tok.weight, std=0.02)
        if self.pos is not None:
            nn.init.normal_(self.pos.weight, std=0.02)

    def forward(self, idx):
        # idx: (B, T) → logits: (B, T, V)
        x = self.tok(idx)
        if self.use_pos:
            x = x + self.pos(torch.arange(idx.size(1), device=idx.device))
        x = self.drop(x)
        mask = None
        if self.causal:
            # 因果掩码：位置 t 只能看到 0..t。
            # 它有个副作用是 SFT 的福音 —— 见 collate 里关于「右填充」的说明
            mask = nn.Transformer.generate_square_subsequent_mask(
                idx.size(1), device=idx.device)
        x = self.encoder(x, mask=mask)
        return self.head(x)


# ═══════════════════ 加载预训练权重（SFT 的起点） ═══════════════════

def build_model_from_ckpt(ckpt_path, dropout=0.0):
    """
    读 tf_mask.pt，重建同构模型，并把预训练权重装进去。

    这里唯一有点技术含量的地方：SFT 要 3 个特殊符号，词表从 4000 扩到 4003，
    而 nn.Embedding 的形状是固定的 —— 所以只能「新建一个大一点的 embedding，
    把旧的 4000 行原样拷过去，新行按 std=0.02 随机初始化」。
    这就是真实工程里 tokenizer.add_special_tokens(...) + model.resize_token_embeddings(n) 干的事。
    """
    ck = torch.load(ckpt_path, map_location="cpu", weights_only=False)
    sd = ck["model_state"]
    c = ck["args"]
    char2idx, idx2char = dict(ck["char2idx"]), dict(ck["idx2char"])
    V_old = len(char2idx)

    # 1) 扩词表：特殊符号接在后面，旧 id 全部保持不变（否则旧 embedding 行就对不上了）
    for s in SPECIALS:
        if s not in char2idx:
            char2idx[s] = len(char2idx)
            idx2char[char2idx[s]] = s
    V_new = len(char2idx)
    pad_id, eos_id, unk_id = char2idx[PAD], char2idx[EOS], char2idx[UNK]

    max_len = c["seq_len"]
    model = TransformerLM(V_new, c["d_model"], c["heads"], c["layers"], max_len,
                          dropout, use_pos=not c.get("no_pos", False),
                          causal=not c.get("no_mask", False))

    # 2) 装权重：tok.weight / head.weight 因为形状变了要单独拷前 V_old 行
    old_tok = sd["tok.weight"]
    rest = {k: v for k, v in sd.items() if k not in ("tok.weight", "head.weight")}
    model.load_state_dict(rest, strict=False)
    with torch.no_grad():
        model.tok.weight[:V_old].copy_(old_tok)      # 旧的 4000 行原样保留
        # 新的 3 行保持 __init__ 里的 std=0.02 随机初始化即可
    model.head.weight = model.tok.weight             # tying 重新绑定（同一个 Parameter）

    info = dict(char2idx=char2idx, idx2char=idx2char, pad_id=pad_id,
                eos_id=eos_id, unk_id=unk_id, V=V_new, max_len=max_len,
                base_args=c, n_old_vocab=V_old)
    return model, info


