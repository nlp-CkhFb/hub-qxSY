def build_example(question, answer, info, max_len):
    """
    ★★★ SFT 的全部秘密就在这个函数里 ★★★

    把「问：X 答：Y」拼成一条完整序列，然后构造 (x, y)：

        full = prompt_ids + answer_ids + [eos]
        x    = full[:-1]                       # 输入：错开一位的前缀
        y[t] = full[t+1]  如果 t+1 落在 answer 里
             = -100       如果 t+1 还落在 prompt 里（prompt 不算 loss）

    为什么 prompt 不算 loss：
        prompt 是用户喂进来的、模型不需要「生成」的内容。如果也算 loss，
        模型会去学「复述问题」；而且同一句话在不同上下文里答案不同，
        把它当目标反而干扰。这是 SFT 与预训练在 loss 上唯一的实质区别。

    注意 y 已经是「错开一位」的标签（和 transformer_lm.py 里 CharDataset 一样），
    所以模型 forward 之后不用再 shift，直接用 y 对齐 logits。
    """
    prompt_ids = [info["char2idx"].get(ch, info["unk_id"])
                  for ch in TEMPLATE.format(question)]
    answer_ids = [info["char2idx"].get(ch, info["unk_id"]) for ch in answer]
    answer_ids = answer_ids + [info["eos_id"]]      # 末尾一定要有 <eos>，否则模型学不会停

    full = prompt_ids + answer_ids
    if len(full) > max_len:
        # 位置编码只有 max_len 行，超长必须截断。这里直接丢掉样本并提示，
        # 真实工程的做法是「截断 prompt、保住 answer」或者扩长 max_len
        return None

    x = full[:-1]
    n_prompt = len(prompt_ids)
    y = [full[t + 1] if (t + 1) >= n_prompt else IGNORE for t in range(len(x))]

    return {"x": x, "y": y, "prompt_len": n_prompt, "n_answer": len(answer_ids)}


def load_pairs(path):
    """--data 指向 jsonl 时从文件读，否则用内置的 28 条"""
    if not path:
        return SFT_PAIRS
    pairs = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                o = json.loads(line)
                pairs.append((o["instruction"], o["output"]))
    return pairs


class SFTDataset(Dataset):
    """每条样本 = 一个 (x, y)，y 里 prompt 部分已经是 -100"""

    def __init__(self, pairs, info, max_len, drop_long=True):
        self.items = []
        dropped = 0
        for q, a in pairs:
            e = build_example(q, a, info, max_len)
            if e is None:
                dropped += 1
                continue
            self.items.append(e)
        if dropped:
            print(f"⚠ {dropped} 条样本超过 max_len={max_len}，已丢弃")

    def __len__(self):
        return len(self.items)

    def __getitem__(self, i):
        e = self.items[i]
        return torch.tensor(e["x"]), torch.tensor(e["y"])


def collate(batch, pad_id):
    """
    变长样本 → 定长 batch。用「右填充」。

    ★ 为什么右填充可以不传 padding mask：
       因果掩码保证位置 t 只能看 0..t。真实 token 都在左边，pad 都在右边，
        所以任何真实 token 的注意力范围里都不会出现 pad —— 填充是「无害」的。
        如果反过来做左填充，真实 token 就会看到左边的 pad，分布立刻被打乱。
        这是 SFT/微调里很实用的一条经验（生成时的 batch 推理更是依赖它）。
        pad 位置的 label 一律填 -100，本来就不算 loss，所以也不影响梯度。
    """
    max_len = max(len(x) for x, _ in batch)
    xs, ys, attn = [], [], []
    for x, y in batch:
        n = len(x)
        pad = max_len - n
        xs.append(torch.cat([x, torch.full((pad,), pad_id, dtype=torch.long)]))
        ys.append(torch.cat([y, torch.full((pad,), IGNORE, dtype=torch.long)]))
        attn.append([1] * n + [0] * pad)
    return {"x": torch.stack(xs), "y": torch.stack(ys),
            "attn": torch.tensor(attn, dtype=torch.long)}


# ═══════════════════ 评估 ═══════════════════

@torch.no_grad()
def evaluate(model, loader, device, info):
    """
    只统计「answer 位置」的 loss 和 PPL，口径和训练时完全一致。
    计算时把 label 里的 -100 过滤掉，因为它会被 cross_entropy 忽略，
    但我们算 PPL 时要除以「有效的 token 数」而不是总 token 数。
    """
    model.eval()
    total, tokens = 0.0, 0
    for b in loader:
        x, y = b["x"].to(device), b["y"].to(device)
        logits = model(x)
        total += float(F.cross_entropy(logits.reshape(-1, logits.size(-1)),
                                       y.reshape(-1), ignore_index=IGNORE,
                                       reduction="sum"))
        tokens += int((y != IGNORE).sum())
    if tokens == 0:
        return float("inf"), float("inf")
    loss = total / tokens
    return loss, math.exp(loss)


# ═══════════════════ 训练 ═══════════════════

def train(args):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    torch.manual_seed(args.seed)
    random.seed(args.seed)

    print(f"device: {device}")
    model, info = build_model_from_ckpt(args.init, dropout=args.dropout)
    model = model.to(device)
    V, max_len = info["V"], info["max_len"]
    print(f"预训练权重: {args.init}")
    print(f"词表: {info['n_old_vocab']} → {V}（追加 {', '.join(SPECIALS)}）  "
          f"max_len={max_len}  参数量 {sum(p.numel() for p in model.parameters())/1e6:.2f}M")

    pairs = load_pairs(args.data)
    random.shuffle(pairs)
    n_val = max(1, int(len(pairs) * args.val_ratio)) if args.val_ratio > 0 else 0
    val_pairs, tr_pairs = pairs[:n_val], pairs[n_val:]

    tr = SFTDataset(tr_pairs, info, max_len)
    tr_loader = DataLoader(tr, batch_size=args.batch_size, shuffle=True,
                           collate_fn=lambda b: collate(b, info["pad_id"]))
    if n_val:
        va = SFTDataset(val_pairs, info, max_len)
        va_loader = DataLoader(va, batch_size=args.batch_size, shuffle=False,
                               collate_fn=lambda b: collate(b, info["pad_id"]))
    else:
        va_loader = DataLoader(tr, batch_size=args.batch_size, shuffle=False,
                               collate_fn=lambda b: collate(b, info["pad_id"]))

    print(f"训练样本 {len(tr)} 条，留出 {len(val_pairs)} 条")
    # 打印一条样本，让你亲眼看到 -100 是怎么把 prompt 屏蔽掉的
    e = tr.items[0]
    print(f"\n样本示例（前 20 个位置）：")
    print(f"  x     : {list(e['x'][:20])}")
    print(f"  y     : {list(e['y'][:20])}   ← 前 {e['prompt_len']-1} 个是 -100")
    print(f"  原文   : {''.join(info['idx2char'][i] for i in e['x'])}")

    # 学习率：SFT 用 1e-5 ~ 5e-5（真实 7B 模型），这里模型小所以放大到 2e-4。
    # 但一定比预训练的 1e-3 小 —— 预训练是「从零学语言」，SFT 是「在已有能力上挪一点点」，
    # 学习率大了会把预训练学到的语言能力冲掉，这就是灾难性遗忘。
    opt = torch.optim.Adam(model.parameters(), lr=args.lr)
    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=args.epochs)

    print(f"\n{'Epoch':>6} {'TrainLoss':>10} {'ValPPL(ans)':>12} {'tok/s':>8}")
    print("-" * 44)
    best = float("inf")
    for ep in range(1, args.epochs + 1):
        model.train()
        st, seen, tot = time.time(), 0, 0.0
        for b in tr_loader:
            x, y = b["x"].to(device), b["y"].to(device)
            logits = model(x)                       # (B, T, V)
            # ★★★ 第二处核心：多了 ignore_index=IGNORE ★★★
            # 没有它，label 里的 -100 会被当成「第 -100 类」，直接报 index out of range。
            # 有它，prompt 和 padding 位置就被完全排除在 loss 之外。
            loss = F.cross_entropy(logits.reshape(-1, V), y.reshape(-1),
                                   ignore_index=IGNORE)
            opt.zero_grad()
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            opt.step()
            n = int((y != IGNORE).sum())
            tot += float(loss.detach()) * n
            seen += n
        sched.step()
        dt = time.time() - st
        v_loss, v_ppl = evaluate(model, va_loader, device, info)
        mark = ""
        if v_ppl < best:
            best = v_ppl
            mark = " *"
            bc = info["base_args"]
            ck = {"model_state": model.state_dict(), "char2idx": info["char2idx"],
                  "idx2char": info["idx2char"],
                  # arch：重建模型结构需要的信息（来自预训练 ckpt 的 args）
                  "arch": {"d_model": bc["d_model"], "heads": bc["heads"],
                           "layers": bc["layers"],
                           "no_pos": bc.get("no_pos", False),
                           "no_mask": bc.get("no_mask", False)},
                  "train_args": vars(args),
                  "specials": {"pad": info["pad_id"], "eos": info["eos_id"],
                               "unk": info["unk_id"]},
                  "max_len": max_len, "stage": "sft"}
            torch.save(ck, args.save)
        if ep % args.log_every == 0 or ep == 1 or ep == args.epochs:
            print(f"{ep:>6} {tot/max(seen,1):>10.4f} {v_ppl:>12.2f} "
                  f"{seen/dt:>8,.0f}{mark}")

    print(f"\n最佳 answer-PPL: {best:.2f}  已保存 {args.save}")
    print("接下来试：")
    print(f'    python {os.path.basename(__file__)} --ckpt {args.save} --chat "中国的首都是哪里"')


# ═══════════════════ 生成 / 对话 ═══════════════════

@torch.no_grad()
def answer(model, info, question, device, max_new=40, temperature=0.0):
    """
    生成回答：喂 prompt，逐字往外蹦，遇到 <eos> 就停。

    和 transformer_lm.py 的 generate 只有两处不同：
        1) 输入套上 TEMPLATE（SFT 训练时见过这个格式，模型靠它知道「该答了」）
        2) 多一个「遇到 <eos> 就 break」的停止条件（预训练模型永远不停，因为它没学过 eos）
    依然是逐 token 串行 —— 自回归模型的本质没有变。
    """
    model.eval()
    ids = [info["char2idx"].get(ch, info["unk_id"]) for ch in TEMPLATE.format(question)]
    out = list(ids)
    for _ in range(max_new):
        # 位置编码只有 max_len 行，所以只看最近 max_len 个 token
        idx = torch.tensor([out[-info["max_len"]:]], device=device)
        logits = model(idx)[0, -1]
        if temperature <= 0.01:
            nxt = int(logits.argmax())          # 贪心：结果可复现，方便对比
        else:
            nxt = int(torch.multinomial(F.softmax(logits / temperature, dim=-1), 1))
        if nxt == info["eos_id"]:
            break                               # ★ 学会停了，这是 SFT 带来的
        out.append(nxt)
    return "".join(info["idx2char"][i] for i in out[len(ids):])


def load_sft_model(path, device):
    """从 SFT 的 ckpt 还原模型 + 字表 + 特殊符号（chat / compare 共用）"""
    ck = torch.load(path, map_location="cpu", weights_only=False)
    assert ck.get("stage") == "sft", \
        f"{path} 不是 SFT 模型（没有 <eos>，也没学过对话格式），请先用 train 存一份"
    a = ck["arch"]
    info = {"char2idx": ck["char2idx"], "idx2char": ck["idx2char"],
            "pad_id": ck["specials"]["pad"], "eos_id": ck["specials"]["eos"],
            "unk_id": ck["specials"]["unk"], "V": len(ck["char2idx"]),
            "max_len": ck["max_len"]}
    model = TransformerLM(info["V"], a["d_model"], a["heads"], a["layers"],
                          info["max_len"], 0.0,
                          use_pos=not a["no_pos"],
                          causal=not a["no_mask"]).to(device)
    model.load_state_dict(ck["model_state"])
    model.head.weight = model.tok.weight
    model.eval()
    return model, info


def chat(args):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model, info = load_sft_model(args.ckpt, device)

    qs = [args.chat] if isinstance(args.chat, str) else args.chat
    for q in qs:
        print(f"问：{q}")
        print(f"答：{answer(model, info, q, device, args.max_new, args.temperature)}\n")


def compare(args):
    """同一个问题，预训练基座 vs SFT 之后"""
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    base, info = build_model_from_ckpt(args.init, dropout=0.0)
    base = base.to(device)
    base.eval()
    ft, _ = load_sft_model(args.save, device)

    qs = ["中国的首都是哪里", "你好", "1加1等于几", "太阳从哪边升起"]
    for q in qs:
        print(f"问：{q}")
        # 基座：同样的 prompt，但它没学过 <eos>，只能截断到固定长度
        print(f"  [SFT前] {answer(base, info, q, device, 40, 0.0)}")
        print(f"  [SFT后] {answer(ft, info, q, device, 40, 0.0)}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--init", default=os.path.join(HERE, "tf_mask.pt"),
                    help="预训练 checkpoint（SFT 的起点）")
    ap.add_argument("--data", default="sft_train.jsonl", help="jsonl 指令数据；不给就用内置 28 条")
    ap.add_argument("--save", default="sft_best.pt")
    ap.add_argument("--ckpt", default="sft_best.pt", help="--chat 时加载哪个 SFT 模型")
    ap.add_argument("--epochs", type=int, default=80)
    # 2e-4：比预训练的 1e-3 小一个量级，防止灾难性遗忘
    ap.add_argument("--lr", type=float, default=2e-4)
    ap.add_argument("--batch_size", type=int, default=8)
    ap.add_argument("--dropout", type=float, default=0.0, help="SFT 数据少，通常调小")
    ap.add_argument("--val_ratio", type=float, default=0.1, help="留出多少做泛化检验")
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--log_every", type=int, default=10)
    ap.add_argument("--max_new", type=int, default=40)
    ap.add_argument("--temperature", type=float, default=0.0, help="0=贪心，可复现")
    ap.add_argument("--chat", default="", help="用训好的模型回答一个问题")
    ap.add_argument("--compare", action="store_true", help="对比 SFT 前后的回答")
    #给定两个数值，计算它们的平均值并显示结果。 第一个数值: 24 第二个数值： 36
    args = ap.parse_args()

    if args.chat:
        chat(args)
    else:
        train(args)
        if args.compare:
            print("\n" + "=" * 50)
            compare(args)


if __name__ == "__main__":
    main()
